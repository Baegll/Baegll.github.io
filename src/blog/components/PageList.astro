---
import config from "../config"
import { type FullSlug, resolveRelative } from "../../quartz/util/path"
import { getDate } from "../../quartz/components/Date"
import { byDateAndAlphabeticalFolderFirst, type SortFn } from "../../quartz/components/PageList"
import type { QuartzPluginData } from "../../quartz/plugins/vfile"
import DateTime from "./DateTime.astro"

interface Props {
  fileData: QuartzPluginData
  allFiles: QuartzPluginData[]
  limit?: number
  sort?: SortFn
}

const { fileData, allFiles, limit, sort } = Astro.props
const cfg = config.configuration
const sorter = sort ?? byDateAndAlphabeticalFolderFirst(cfg)
let list = allFiles.sort(sorter)
if (limit) {
  list = list.slice(0, limit)
}
---

<ul class="section-ul">
  {
    list.map((page) => (
      <li class="section-li">
        <div class="section">
          <p class="meta">
            {page.dates && <DateTime date={getDate(cfg, page)!} locale={cfg.locale} />}
          </p>
          <div class="desc">
            <h3>
              <a href={resolveRelative(fileData.slug!, page.slug!)} class="internal">
                {page.frontmatter?.title}
              </a>
            </h3>
          </div>
          <ul class="tags">
            {(page.frontmatter?.tags ?? []).map((tag) => (
              <li>
                <a
                  class="internal tag-link"
                  href={resolveRelative(fileData.slug!, `tags/${tag}` as FullSlug)}
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ul>
