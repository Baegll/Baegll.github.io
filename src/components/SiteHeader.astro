---
import ThemeIcons from "./ThemeIcons.astro"
const links = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/blog/", label: "Writing" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
]
const path = Astro.url.pathname
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <a class="site-name" href="/" aria-label="Natalie Johanek home">Natalie Johanek<span aria-hidden="true">.</span></a>
  <nav aria-label="Primary">
    {links.map(({ href, label }) => (
      <a href={href} data-router-ignore aria-current={!href.includes("#") && (href === "/" ? path === "/" : path.startsWith(href)) ? "page" : undefined}>{label}</a>
    ))}
  </nav>
  <button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle color theme" title="Toggle color theme"><ThemeIcons size={18} /></button>
</header>
<script>
  // Reflect native anchor navigation without intercepting clicks or browser history.
  function markSection() {
    if (location.pathname !== "/") return
    const links = document.querySelectorAll<HTMLAnchorElement>('.site-header nav a')
    const section = ["#about", "#contact"].includes(location.hash) ? location.hash : ""
    for (const link of links) {
      if (link.getAttribute("href") === "/" + section) {
        link.setAttribute("aria-current", section ? "location" : "page")
      } else link.removeAttribute("aria-current")
    }
  }
  markSection()
  window.addEventListener("hashchange", markSection)
</script>
<style>
  .site-header { box-sizing: border-box; width: min(100% - 64px, 1120px); margin: 0 auto; padding: 24px 0; display: flex; align-items: center; gap: 28px; border-bottom: 1px solid var(--t-border); font: 500 14px/1.5 var(--t-font-body); }
  .site-header a { text-decoration: none; background: none; transition: color 150ms; }
  .site-name { color: var(--t-primary); font-weight: 700; font-size: 17px; white-space: nowrap; margin-right: auto; }
  .site-name span { color: var(--t-cta); }
  nav { display: flex; align-items: center; gap: 24px; }
  nav a { color: var(--t-muted); padding: 10px 0; }
  nav a:hover, nav a[aria-current] { color: var(--t-cta); }
  nav a[aria-current] { text-decoration: underline; text-underline-offset: 7px; text-decoration-thickness: 2px; }
  .theme-toggle { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; padding: 0; border: 0; border-radius: 10px; background: transparent; color: var(--t-muted); cursor: pointer; transition: background-color 150ms, color 150ms; }
  .theme-toggle:hover { background: var(--t-highlight); color: var(--t-cta); }
  .site-header :focus-visible, .skip-link:focus-visible { outline: 2px solid var(--t-cta); outline-offset: 5px; border-radius: 3px; }
  .skip-link { position: fixed; left: 16px; top: 12px; z-index: 1000; padding: 12px 16px; background: var(--t-surface); color: var(--t-cta); transform: translateY(-200%); }
  .skip-link:focus { transform: none; }
  @media (max-width: 640px) {
    .site-header { width: calc(100% - 40px); gap: 0; padding: 16px 0 8px; flex-wrap: wrap; }
    .site-name { font-size: 16px; }
    nav { order: 3; width: 100%; justify-content: space-between; gap: 12px; }
    nav a { font-size: 13px; padding: 12px 0; }
  }
  @media (prefers-reduced-motion: reduce) { .site-header a, .theme-toggle { transition: none; } }
</style>
