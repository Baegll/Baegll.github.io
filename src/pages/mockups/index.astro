---
import ThemeHead from "../../components/ThemeHead.astro"
import ThemeIcons from "../../components/ThemeIcons.astro"
const studies = [
  { slug: "editorial", number: "01", name: "Wide masthead", description: "A full-width name above a wide portrait and introduction, followed by paired projects and a writing list.", detail: "A clear, open reading order with strong horizontal alignment." },
  { slug: "field-notes", number: "02", name: "Sidebar index", description: "Persistent navigation beside a split introduction, with About first, then Projects and Writing.", detail: "A clean background and descriptive project covers keep attention on the content." },
  { slug: "studio", number: "03", name: "Asymmetric grid", description: "An oversized name overlaps the portrait, with staggered project blocks and a centered contact section.", detail: "The most expressive composition, using the same typography and palette." },
]
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Three directions — Natalie Johanek</title><ThemeHead /></head>
  <body><main><button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle color theme"><ThemeIcons size={18} /></button><a class="back" href="/">← Current site</a><p class="eyebrow">Layout studies / October 2026</p><h1>Same brand.<br />Three layouts.</h1><p class="intro">All three use the existing black, white, and pink palette, Archivo headings, Space Grotesk body text, and the same content. Each is a working, responsive page—open one, resize it, and follow the links.</p><div class="studies">{studies.map(study => <article><a class={`preview ${study.slug}`} href={`/mockups/${study.slug}`} aria-label={`Open ${study.name}`}><span>{study.number} / Layout study</span><strong>Natalie<br /><em>Johanek.</em></strong><div class="preview-bottom"><span>Engineering. Writing. Fencing.</span><span>↗</span></div></a><h2>{study.name}</h2><p>{study.description}</p><p class="detail">{study.detail}</p><a class="open" href={`/mockups/${study.slug}`}>Open full mockup ↗</a></article>)}</div><p class="note">These are visual studies, not replacements for the current site. Project, article, and contact links work; the preview navigation moves between sections of each study.</p></main></body>
</html>
<style>
  * { box-sizing: border-box; }
  body { background: var(--t-surface); color: var(--t-text); margin: 0; font: 16px/1.7 var(--t-font-body); -webkit-font-smoothing: antialiased; }
  main { max-width: 1280px; padding: 40px; margin: auto; }
  a { color: inherit; text-underline-offset: 5px; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--t-cta); outline-offset: 5px; }
  .back { font-size: 13px; text-decoration: none; }
  .eyebrow { margin-top: 64px; text-transform: uppercase; letter-spacing: .15em; font-size: 11px; color: var(--t-muted); }
  h1 { font: 900 clamp(40px,6vw,72px)/1.05 var(--t-font-heading); letter-spacing: -.045em; margin: 20px 0; }
  .intro { max-width: 65ch; color: var(--t-secondary); margin-bottom: 48px; }
  .studies { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 28px; }
  .preview { display: flex; flex-direction: column; padding: 24px; min-height: 300px; text-decoration: none; background: color-mix(in srgb, var(--t-text) 4%, var(--t-surface)); border: 1px solid var(--t-border); }
  .preview > span { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: var(--t-muted); }
  .preview strong { font: 900 clamp(36px,4vw,60px)/1 var(--t-font-heading); letter-spacing: -.05em; margin: 44px 0; }
  .preview em { color: var(--t-cta); font-style: normal; }
  .preview-bottom { display: flex; justify-content: space-between; gap: 16px; font-size: 10px; margin-top: auto; color: var(--t-muted); }
  .preview.field-notes { border-left: 24px solid var(--t-border); }
  .field-notes strong { font-size: clamp(28px,3.1vw,44px); }
  .studio strong { transform: translateX(8px); }
  .studio strong em { display: inline-block; transform: translateX(8px); }
  h2 { font: 700 22px/1.3 var(--t-font-heading); margin: 24px 0 12px; }
  article > p { color: var(--t-secondary); font-size: 14px; }
  .detail { border-top: 1px solid var(--t-border); padding-top: 16px; }
  .open { display: inline-block; font-size: 14px; margin-top: 12px; padding: 8px 0; color: var(--t-cta); }
  .note { color: var(--t-muted); font-size: 13px; max-width: 80ch; margin-top: 64px; }
  .theme-toggle { float: right; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 8px; background: none; color: var(--t-muted); cursor: pointer; }
  .theme-toggle:hover { background: var(--t-highlight); color: var(--t-cta); }
  :global(.dark .icon-sun) { display: block !important; }
  :global(.dark .icon-moon) { display: none; }
  @media(max-width:850px) { .studies { grid-template-columns: 1fr; } main { padding: 24px; } .preview strong { font-size: clamp(40px,12vw,64px); } .eyebrow { margin-top: 40px; } }
</style>
